# ColdRevive .gitignore

# Rust / Cargo（含 tests/spikes/s2/* 下的独立 spike crate）
**/target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# 文档构建产物（由 scripts/build_docs.py 生成，不纳入版本控制）
docs/**/*.html
!docs/index.html

# 本地运行数据与索引库
*.db
*.db-wal
*.db-shm
/coldrevive.toml
/config/local.toml
/data/
/logs/

# 共享目录（用户内容，绝不入库）
/Shared/
/shared/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
*~
# Windows 保留名文件：Git Bash 里 `2>nul` 未走设备名而落盘生成的空壳（非项目产物，
# 且 Win32 回收站 API 无法处理该名字；只忽略、不自动删除）
nul

# T0 验收运行产物（由 tests/e2e/t0/ 脚本生成，不纳入版本控制）
tests/e2e/t0/.run/
tests/e2e/t0/reports/*
!tests/e2e/t0/reports/.gitkeep
tests/fixtures/t0/sample/*
!tests/fixtures/t0/sample/.gitkeep

# T1 双机验收运行产物（同样只在本机留证据，不入库）
tests/e2e/t1/.run/
tests/e2e/t1/reports/*
!tests/e2e/t1/reports/.gitkeep

# T2 M2 跨 NAT 接线预检运行产物（本地证据，不入库）
tests/e2e/t2/.run/
tests/e2e/t2/reports/*
!tests/e2e/t2/reports/.gitkeep

# G3 兼容性矩阵基线报告（本机客户端可用性清点，不入库）
tests/e2e/g3/reports/*

# W5.1 引擎下载验收运行产物（本地证据，不入库）
tests/e2e/w51/reports/*

# W5.1b 引擎做种 → 第三方客户端验收运行产物（本地证据，不入库）
tests/e2e/w51b/reports/*

# W5.1c LAN 跨主机复核运行产物（本地证据，不入库）
tests/e2e/w51c/reports/*

# W5.1d 公网入向复核运行产物（本地证据，不入库）
tests/e2e/w51d/reports/*

# W5.1e µTP 互操作复核运行产物（本地证据，不入库）
tests/e2e/w51e/reports/*

# W5.1f 公网 µTP 复核运行产物（本地证据，不入库）
tests/e2e/w51f/reports/*

# W5.1g aMule 公网 KAD 复核运行产物（本地证据，不入库）
tests/e2e/w51g/reports/*

# W5.2 唤醒可达性决策复核运行产物（本地证据，不入库）
tests/e2e/w52/reports/*

# M0 Spike 就绪度报告（由 m0_preflight.py 生成，不纳入版本控制）
tests/spikes/reports/*
!tests/spikes/reports/.gitkeep

# 本地智能体工作记忆（仅本机，不进入公开仓库）
.workbuddy/

# Python
__pycache__/
*.py[cod]
.venv/

# e2e 本地工作目录（种子/配置/日志，每次运行重建）
/.run/

# 家宽 kit 回传的原始 results（含本机地址/主机名，绝不入库；只留脱敏结论）
dist/results*.zip
